# Foundry API Configuration
VITE_FOUNDRY_API_URL=https://your-foundry-instance.palantirfoundry.com
VITE_FOUNDRY_REDIRECT_URL=https://your-app-domain/auth/callback
VITE_FOUNDRY_CLIENT_ID=your-client-id-here

